# Copy this file to .env and adjust the values.
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# .env is git-ignored and must never be committed.

# ---- Server ----
NODE_ENV=development
PORT=3000

# 0.0.0.0 so a physical phone on the same Wi-Fi can reach the API.
# Use your machine's LAN IP (not 127.0.0.1) from the phone.
HOST=0.0.0.0

# ---- MongoDB ----
# Local install:  mongodb://127.0.0.1:27017/visit_log
# Docker:         mongodb://host.docker.internal:27017/visit_log
MONGODB_URI=mongodb://127.0.0.1:27017/visit_log

# ---- Data files (used by the import / seed scripts) ----
SCHOOLS_FILE=data/schools.json
QUESTIONNAIRES_FILE=data/questionnaires.json
