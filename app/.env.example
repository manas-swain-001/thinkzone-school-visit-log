# Copy to .env and adjust. .env is git-ignored and must never be committed.
#   Copy-Item .env.example .env
#
# Expo inlines every EXPO_PUBLIC_* variable into the JS bundle at build time.
# The value is only the *default*: it can be changed at runtime from the app's
# Settings screen, which is handy when the laptop moves to a different Wi-Fi.

# Base URL of the visit-log API, with no trailing slash.
#
#   Physical phone on the same Wi-Fi : your laptop's LAN IP, e.g. http://192.168.1.131:3000
#   Android emulator                 : http://10.0.2.2:3000
#
# 127.0.0.1 will NOT work on a real phone: from the phone it means the phone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.131:3000
